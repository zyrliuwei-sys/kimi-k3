# ShipAny Next — environment variables
#
# Local development:
#   cp .env.example .env.development   # then fill in the values below
#
# Loader priority (scripts/with-env.ts + vite loadEnvFiles):
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
# So in dev, .env.development is picked up by both `pnpm dev` and the db scripts.
#
# Keep this file minimal: provider credentials (payments, OAuth, email,
# storage, AI, analytics) are configured in the admin panel → Settings and
# stored in the database (encrypted when CONFIG_ENCRYPTION_KEY is set).
# Env vars with the matching names still work as fallbacks — database values
# take precedence — but they don't need to live in this template.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=kimik3
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:data/local.db
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# App (optional — sensible defaults exist in src/config/index.ts)
# ---------------------------------------------------------------------------
VITE_APP_DESCRIPTION=Ship your SaaS faster
VITE_APP_LOGO=/logo.svg
VITE_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Admin settings encryption (recommended)
# ---------------------------------------------------------------------------
# Encrypts secrets saved via admin Settings (AES-256-GCM) in the config table.
# Unset = plaintext storage. Once set, keep it stable — rotating or removing
# it orphans already-encrypted values (they fall back to env values).
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (advanced / non-sqlite)
# ---------------------------------------------------------------------------
# DATABASE_PROVIDER options: sqlite | postgres | mysql | turso | d1
#   PostgreSQL: postgresql://user:pass@localhost:5432/dbname
#   MySQL:      mysql://user:pass@localhost:3306/dbname
#   Turso:      libsql://<db>.turso.io   (also set DATABASE_AUTH_TOKEN below)
# DATABASE_AUTH_TOKEN=                # Turso auth token (required for turso)
# DB_SCHEMA=public                    # Postgres schema
# DB_SINGLETON_ENABLED=false          # reuse a single connection (serverless)
# DB_MAX_CONNECTIONS=1

# ---------------------------------------------------------------------------
# Auth (optional — AUTH_URL defaults to VITE_APP_URL)
# ---------------------------------------------------------------------------
# AUTH_URL=http://localhost:3000

# Google OAuth + GitHub OAuth + Magic Link are configured in the ADMIN PANEL
# by default, but they ALSO read these env vars as fallbacks (admin DB still
# wins). Useful for local dev where the admin panel isn't set up yet —
# fill in the *_CLIENT_ID / *_CLIENT_SECRET below and the buttons light up
# automatically (no admin toggle required).
#
#   Admin → Settings → Auth
#     • Google client id / secret — Google Cloud Console
#       (https://console.cloud.google.com/apis/credentials, OAuth 2.0 Client)
#     • GitHub client id / secret — GitHub Developer Settings
#       (https://github.com/settings/developers, OAuth App)
#     • Magic link enabled = true (after Resend is configured under Email)
#   Admin → Settings → Email
#     • Resend api key + sender email (also used for password reset,
#       verification, and magic-link delivery — no second credential needed)
#
# OAuth callback URL to register in each provider's console (when running
# locally on port 3000):
#   Google:  http://localhost:3000/api/auth/callback/google
#   GitHub:  http://localhost:3000/api/auth/callback/github
# In production, swap localhost for your real AUTH_URL / VITE_APP_URL host.
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=               # optional — auto-set to true when id+secret are present
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTH_ENABLED=               # optional — auto-set to true when id+secret are present

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile) — optional
# ---------------------------------------------------------------------------
# Guards public identity and email-sending actions against bots. Both keys must
# be configured before enabling Turnstile. Once enabled, the server fails
# closed if either key or the hostname allowlist cannot be resolved.
#
# The site key is public (exposed to the browser via /api/config/public so the
# widget can render). The secret is server-only — sent to Cloudflare's
# siteverify endpoint, never to the client. Create the widget in the
# Cloudflare dashboard (Turnstile); both keys come from there.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Optional explicit Siteverify hostname allowlist, comma-separated. Leave blank
# to use the hostname in VITE_APP_URL / AUTH_URL (recommended for one domain).
TURNSTILE_HOSTNAMES=
